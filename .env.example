# Public origins allowed to issue state-changing requests. Comma-separate multiple origins.
TRUSTED_ORIGINS=https://tpad.example.com

# 32 random bytes encoded as base64 or 64 hexadecimal characters.
DATA_SOURCE_ENCRYPTION_KEY=
DATA_SOURCE_ENCRYPTION_KEY_VERSION=v1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1
ORACLE_EXCLUDED_SCHEMAS=SYS,SYSTEM,XDB,MDSYS,CTXSYS,ORDSYS,DBSNMP,OUTLN,AUDSYS,GSMADMIN_INTERNAL

# Optional: local read-only Oracle integration verifier. Never commit real values.
ORACLE_TEST_HOST=
ORACLE_TEST_PORT=1521
ORACLE_TEST_DATABASE=
ORACLE_TEST_USERNAME=
ORACLE_TEST_PASSWORD=
ORACLE_TEST_SCHEMA=
ORACLE_TEST_SOURCE_NAME=Oracle read-only verification
